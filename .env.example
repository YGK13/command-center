# ============================================================
# Command Center — environment config
# Copy this file to ".env" (same folder) and fill in the values.
# .env is gitignored and never committed.
# ============================================================

# The Gmail address the brief is SENT FROM.
GMAIL_USER=you@gmail.com

# A Google APP PASSWORD — 16 characters, NOT your normal login password.
# Turn on 2-Step Verification, then create one at:
#   https://myaccount.google.com/apppasswords
# Paste it with no spaces, e.g. GMAIL_APP_PASSWORD=abcdfghijklmnop
GMAIL_APP_PASSWORD=

# Where the brief is delivered. Leave blank to send to GMAIL_USER (yourself).
BRIEF_TO=you@gmail.com

# Days the brief is NOT emailed (data still refreshes). Weekday numbers,
# 0=Sun ... 6=Sat, comma separated. Default: 6 (Saturday).
# Sun-Thu week: REST_DAYS=5,6   Every day: REST_DAYS=none
REST_DAYS=6
